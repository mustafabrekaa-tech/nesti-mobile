{
  "appId": "com.nesticampus.app",
  "appName": "NESTI",
  "webDir": "www",
  "server": {
    "url": "https://nesticampus.com/app",
    "allowNavigation": [
      "nesticampus.com",
      "*.nesticampus.com"
    ],
    "errorPath": "index.html"
  },
  "android": {
    "allowMixedContent": false,
    "adjustMarginsForEdgeToEdge": "force"
  },
  "ios": {
    "contentInset": "always"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#0E3B35",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#F6F4EF",
      "overlaysWebView": false
    }
  }
}
